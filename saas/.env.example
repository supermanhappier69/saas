# Copy to .env and `set -a; . ./.env; set +a` before `npm run latepay`, or set these on your host.
# Required in production
APP_SECRET=change-me-to-a-long-random-string
BASE_URL=https://paidontime.example.com
NODE_ENV=production
TRUST_PROXY=1

# Who can open the founder console (/app/founder), comma-separated login emails
FOUNDER_EMAILS=you@example.com

# Email (one of these; otherwise emails are stored in Activity → Emails and not sent)
RESEND_API_KEY=
POSTMARK_TOKEN=
MAIL_FROM=PaidOnTime <hello@paidontime.example.com>
CONTACT_TO=you@example.com
SUPPORT_EMAIL=you@example.com

# Stripe (one-off prices for Core and Complete)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CORE=
STRIPE_PRICE_COMPLETE=

# Let search engines index the public pages
ALLOW_INDEXING=1

# Development only: switch plans without paying. Never set in production.
# ALLOW_FAKE_BILLING=1
